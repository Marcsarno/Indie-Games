{
  "name": "gobble-kitchen",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/make-artifact.mjs",
    "assets": "bash scripts/build-assets.sh",
    "typecheck": "tsc --noEmit",
    "voice": "cd tools/voice && node build-voice.mjs",
    "play": "node tools/play.mjs .work/shots --script feast"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.0",
    "@types/three": "0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
